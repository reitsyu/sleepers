<UserControl x:Class="Sleepers.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Settings" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Output"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Output folder (leave empty to save next to the original file)"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseOut_Click"/>
                        <TextBox x:Name="OutDirBox"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Filename suffix" Margin="0,12,0,4"/>
                    <TextBox x:Name="SuffixBox" Width="240" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0"
                               Text="SLEEPERS never overwrites existing files or the original: if a name is taken, “ (1)”, “ (2)” … is added."/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Default preset for new videos" Margin="0,12,0,4"/>
                    <ComboBox x:Name="PresetBox" Width="240" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Performance"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Software encoder threads"/>
                    <ComboBox x:Name="ThreadBox" DisplayMemberPath="Label" SelectedValuePath="Value" Width="240" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0"
                               Text="Automatic lets FFmpeg size its thread pool for your CPU (including AMD Ryzen) and is the best choice for most people. Lower it to keep the PC responsive during long encodes."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="FFmpeg"/>
                    <TextBlock x:Name="FfmpegText" Style="{StaticResource Dim}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Choose ffmpeg.exe…" Click="BrowseFfmpeg_Click"/>
                        <Button Content="Re-detect hardware" Margin="8,0,0,0" Click="Redetect_Click"/>
                        <Button Content="Open log folder" Margin="8,0,0,0" Click="Logs_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="Save settings" Style="{StaticResource Primary}" Click="Save_Click"/>
                <TextBlock x:Name="SavedText" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
