<UserControl x:Class="Sleepers.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="32,28">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H1}" Text="History"/>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,14,0,14">
            <Button Content="Open file" Click="OpenFile_Click"/>
            <Button Content="Show in folder" Margin="8,0,0,0" Click="Folder_Click"/>
            <Button Content="Clear history" Margin="8,0,0,0" Click="Clear_Click"/>
        </StackPanel>
        <Border Style="{StaticResource CardStyle}" Padding="6" Margin="0">
            <ListView x:Name="List" Background="Transparent" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="When" Width="130" DisplayMemberBinding="{Binding DateText}"/>
                        <GridViewColumn Header="File" Width="210" DisplayMemberBinding="{Binding SourceName}"/>
                        <GridViewColumn Header="Result" Width="60" DisplayMemberBinding="{Binding ResultText}"/>
                        <GridViewColumn Header="Original" Width="80" DisplayMemberBinding="{Binding OriginalText}"/>
                        <GridViewColumn Header="Output" Width="80" DisplayMemberBinding="{Binding OutputText}"/>
                        <GridViewColumn Header="Change" Width="120" DisplayMemberBinding="{Binding ReductionText}"/>
                        <GridViewColumn Header="Resolution" Width="150" DisplayMemberBinding="{Binding ResolutionText}"/>
                        <GridViewColumn Header="Format / codec" Width="110" DisplayMemberBinding="{Binding FormatText}"/>
                        <GridViewColumn Header="Length" Width="70" DisplayMemberBinding="{Binding DurationText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</UserControl>
