<Window x:Class="Sleepers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SLEEPERS" Width="1240" Height="800" MinWidth="1020" MinHeight="660"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,16">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,22">
                    <TextBlock Text="SLEEPERS" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Video &amp; audio compression" Style="{StaticResource Dim}" FontSize="11.5"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Dim}" FontSize="11.5" Margin="8,10,8,0"/>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Content="Home" Tag="Home" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Video Compressor" Tag="Video" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Audio Converter" Tag="Audio" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Batch Queue" Tag="Queue" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="History" Tag="History" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="Settings" Tag="Settings" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="Host" Grid.Column="1"/>
    </Grid>
</Window>
